Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"\<\"Non diagonal mass term found: \"\>", "\[InvisibleSpace]", 
    RowBox[{"-", "3"}], " ", 
    SqrtBox["2"], " ", "vev", " ", 
    SubsuperscriptBox[
     RowBox[{"(", 
      TemplateBox[{"y", "QLdR"},
       "Superscript"], ")"}], 
     RowBox[{"1", ",", "1"}], "\<\"*\"\>"], " ", 
    RowBox[{
     SubscriptBox[
      OverscriptBox["dR", "\<\"-\"\>"], 
      RowBox[{"r$16821", ",", "1", ",", "cc"}]], ".", 
     SubscriptBox["QL", 
      RowBox[{"r$16821", ",", "2", ",", "1", ",", "cc"}]]}]}], "-", 
   RowBox[{"3", " ", 
    SqrtBox["2"], " ", "vev", " ", 
    SubsuperscriptBox[
     RowBox[{"(", 
      TemplateBox[{"y", "QLdR"},
       "Superscript"], ")"}], 
     RowBox[{"1", ",", "2"}], "\<\"*\"\>"], " ", 
